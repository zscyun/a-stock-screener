# ============================================================
# Screener Email Dispatch — SMTP 邮件配置模板
# ============================================================
# 使用方法：
#   1. 复制此文件为 email_config.env（同名，去掉 .example）
#      cp email_config.env.example email_config.env
#   2. 修改下面的值为你的实际邮箱/SMTP 信息
#   3. email_config.env 已在 .gitignore 中，不会被提交到 Git
# ============================================================

# ── SMTP 服务器配置 ────────────────────────────────
# QQ 邮箱: smtp.qq.com
# 163 邮箱: smtp.163.com
# Gmail:   smtp.gmail.com
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587

# ── 发件人信息 ─────────────────────────────────────
SENDER_EMAIL=your_email@example.com

# ── SMTP 授权密码（非登录密码） ────────────────────
# QQ 邮箱：设置 → 账户 → POP3/SMTP服务 → 生成授权码
# Gmail：Google 账号 → 安全性 → App Passwords
# 163 邮箱：设置 → 客户端授权密码
SMTP_PASSWORD=your_smtp_auth_code_here

# ── 收件人列表（多个邮箱用逗号分隔） ────────────────
RECIPIENT_EMAILS=user@example.com

# ── 邮件主题前缀（可选，默认 "📈 盘前选股报告"） ─────
EMAIL_SUBJECT_PREFIX=📈 盘前选股报告
