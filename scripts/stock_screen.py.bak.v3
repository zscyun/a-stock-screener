    # 消费/白酒
    '600519': '贵州茅台', '000858': '五粮液', '600809': '山西汾酒',
    # 金融/保险
    '601318': '中国平安', '600036': '招商银行', '601668': '中国建筑',
    # 医药/生物
    '600276': '恒瑞医药', '300760': '迈瑞医疗', '603259': '药明康德',
